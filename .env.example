# AG Farm — Environment Variables Configuration
# Copy this file to .env and configure your credentials

# Supabase Cloud Backend Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Weather API (OpenWeather / WeatherAPI)
VITE_WEATHER_API_KEY=your_weather_api_key_here
VITE_FARM_LAT=-7.0267
VITE_FARM_LON=113.6231
VITE_FARM_LOCATION="Desa Batuampar, Kec. Guluk-Guluk, Kab. Sumenep, Jawa Timur"

# ESP32 IoT MQTT Broker (Optional)
VITE_MQTT_BROKER_URL=wss://broker.hivemq.com:8884/mqtt
VITE_MQTT_TOPIC_TELEMETRY=agfarm/batuampar/telemetry
VITE_MQTT_TOPIC_COMMAND=agfarm/batuampar/pump
